.decl base(x:number, y:number)
.input base
.decl e(x:number, y:number)
.input e
.decl blocked(x:number)
.input blocked
.decl sibling_edge(x:number, y:number)
.input sibling_edge
.decl q(x:number, y:number)
.decl s(x:number)
.decl p(x:number, y:number)
.decl out(y:number)
.output out
.decl tc(x:number, y:number)
.decl out2(y:number)
.output out2
.decl magic_tc_bf(c0:number)
.decl tc_bf(c0:number, c1:number)
.decl sup_tc_bf_r1_2(c0:number, c1:number)
p(x, y) :- e(x, y).
p(x, y) :- p(x, z), !s(z), q(z, y).
q(x, y) :- base(x, y).
q(x, y) :- q(x, z), base(z, y).
s(x) :- q(x, y), blocked(y).
tc_bf(x, y) :- magic_tc_bf(x), sibling_edge(x, y).
sup_tc_bf_r1_2(x, y) :- magic_tc_bf(x), tc_bf(x, z), sibling_edge(z, y).
magic_tc_bf(x) :- magic_tc_bf(x).
tc_bf(x, y) :- sup_tc_bf_r1_2(x, y).
out(y) :- p(1, y).
magic_tc_bf(1).
out2(y) :- tc_bf(1, y).
