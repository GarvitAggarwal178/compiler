.decl parent(child:number, par:number)
.input parent
.decl person(x:number)
.input person
.decl ancestor(x:number, y:number)
.decl nonancestor(x:number, y:number)
.decl q_nonancestor(y:number)
.output q_nonancestor
.decl magic_nonancestor_bf(c0:number)
.decl sup_nonancestor_bf_r0_2(c0:number, c1:number)
.decl magic_ancestor_bf(c0:number)
.decl nonancestor_bf(c0:number, c1:number)
.decl ancestor_bf(c0:number, c1:number)
.decl sup_ancestor_bf_r1_1(c0:number, c1:number)
.decl sup_ancestor_bf_r1_2(c0:number, c1:number)
sup_nonancestor_bf_r0_2(x, y) :- magic_nonancestor_bf(x), person(x), person(y).
magic_ancestor_bf(x) :- sup_nonancestor_bf_r0_2(x, y).
nonancestor_bf(x, y) :- sup_nonancestor_bf_r0_2(x, y), !ancestor_bf(x, y).
ancestor_bf(x, y) :- magic_ancestor_bf(x), parent(x, y).
sup_ancestor_bf_r1_1(x, z) :- magic_ancestor_bf(x), parent(x, z).
sup_ancestor_bf_r1_2(x, y) :- sup_ancestor_bf_r1_1(x, z), ancestor_bf(z, y).
magic_ancestor_bf(z) :- sup_ancestor_bf_r1_1(x, z).
ancestor_bf(x, y) :- sup_ancestor_bf_r1_2(x, y).
magic_nonancestor_bf(1).
q_nonancestor(y) :- nonancestor_bf(1, y).
