.decl parent(child:number, par:number)
.input parent
.decl person(x:number)
.input person
.decl sg(x:number, y:number)
.decl notsg(x:number, y:number)
.decl q_notsg(y:number)
.output q_notsg
.decl magic_notsg_bf(c0:number)
.decl sup_notsg_bf_r0_2(c0:number, c1:number)
.decl magic_sg_bf(c0:number)
.decl notsg_bf(c0:number, c1:number)
.decl sg_bf(c0:number, c1:number)
.decl sup_sg_bf_r1_2(c0:number, c1:number, c2:number, c3:number)
.decl sup_sg_bf_r1_3(c0:number, c1:number)
.decl magic_sg_bb(c0:number, c1:number)
.decl sg_bb(c0:number, c1:number)
.decl sup_sg_bb_r1_2(c0:number, c1:number, c2:number, c3:number)
.decl sup_sg_bb_r1_3(c0:number, c1:number)
sup_notsg_bf_r0_2(x, y) :- magic_notsg_bf(x), person(x), person(y).
magic_sg_bf(x) :- sup_notsg_bf_r0_2(x, y).
notsg_bf(x, y) :- sup_notsg_bf_r0_2(x, y), !sg_bf(x, y).
sg_bf(x, x) :- magic_sg_bf(x), person(x).
sup_sg_bf_r1_2(x, xp, y, yp) :- magic_sg_bf(x), parent(x, xp), parent(y, yp).
sup_sg_bf_r1_3(x, y) :- sup_sg_bf_r1_2(x, xp, y, yp), sg_bb(xp, yp).
magic_sg_bb(xp, yp) :- sup_sg_bf_r1_2(x, xp, y, yp).
sg_bf(x, y) :- sup_sg_bf_r1_3(x, y), x != y.
sg_bb(x, x) :- magic_sg_bb(x, x), person(x).
sup_sg_bb_r1_2(x, y, xp, yp) :- magic_sg_bb(x, y), parent(x, xp), parent(y, yp).
sup_sg_bb_r1_3(x, y) :- sup_sg_bb_r1_2(x, y, xp, yp), sg_bb(xp, yp).
magic_sg_bb(xp, yp) :- sup_sg_bb_r1_2(x, y, xp, yp).
sg_bb(x, y) :- sup_sg_bb_r1_3(x, y), x != y.
magic_notsg_bf(0).
q_notsg(y) :- notsg_bf(0, y).
