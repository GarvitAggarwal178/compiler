.decl node(x:number)
.input node
.decl edge(x:number, y:number)
.input edge
.decl reach(x:number, y:number)
.decl missing(x:number, y:number)
.decl out(y:number)
.output out
.decl other(y:number)
.output other
.decl untouched(x:number, y:number)
.output untouched
.decl magic_missing_bf(c0:number)
.decl sup_missing_bf_r0_2(c0:number, c1:number)
.decl magic_reach_bf(c0:number)
.decl missing_bf(c0:number, c1:number)
.decl reach_bf(c0:number, c1:number)
.decl sup_reach_bf_r1_2(c0:number, c1:number)
reach(x, y) :- edge(x, y).
reach(x, y) :- reach(x, z), edge(z, y).
untouched(x, y) :- node(x), node(y), !reach(x, y).
sup_missing_bf_r0_2(x, y) :- magic_missing_bf(x), node(x), node(y).
magic_reach_bf(x) :- sup_missing_bf_r0_2(x, y).
missing_bf(x, y) :- sup_missing_bf_r0_2(x, y), !reach_bf(x, y).
reach_bf(x, y) :- magic_reach_bf(x), edge(x, y).
sup_reach_bf_r1_2(x, y) :- magic_reach_bf(x), reach_bf(x, z), edge(z, y).
magic_reach_bf(x) :- magic_reach_bf(x).
reach_bf(x, y) :- sup_reach_bf_r1_2(x, y).
magic_missing_bf(1).
out(y) :- missing_bf(1, y).
magic_missing_bf(3).
other(y) :- missing_bf(3, y).
