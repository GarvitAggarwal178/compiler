.decl base(x:number, y:number)
.input base
.decl e(x:number, y:number)
.input e
.decl blocked(x:number)
.input blocked
.decl chain_seed(x:number)
.input chain_seed
.decl chain_edge(x:number, y:number)
.input chain_edge
.decl sibling_edge(x:number, y:number)
.input sibling_edge
.decl sibling2_edge(x:number, y:number)
.input sibling2_edge
.decl q(x:number, y:number)
.decl gate1b(x:number)
.decl gate1(x:number)
.decl s(x:number)
.decl p(x:number, y:number)
.decl out(y:number)
.output out
.decl tc(x:number, y:number)
.decl out2(y:number)
.output out2
.decl direct(x:number, y:number)
.decl out3(y:number)
.output out3
direct(x, y) :- sibling2_edge(x, y).
gate1(x) :- gate1b(x).
gate1b(x) :- chain_seed(x).
gate1b(x) :- gate1b(y), chain_edge(y, x).
out2(y) :- tc(1, y).
out3(y) :- direct(1, y).
p(x, y) :- e(x, y), gate1(x).
p(x, y) :- p(x, z), !s(z), q(z, y).
q(x, y) :- base(x, y).
q(x, y) :- q(x, z), base(z, y).
s(x) :- q(x, y), blocked(y).
tc(x, y) :- sibling_edge(x, y).
tc(x, y) :- tc(x, z), sibling_edge(z, y).
out(y) :- p(1, y).
