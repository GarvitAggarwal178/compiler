.decl base(x:number, y:number)
.input base
.decl e(x:number, y:number)
.input e
.decl blocked(x:number)
.input blocked
.decl p(x:number, y:number)
.decl s(x:number)
.decl q2(x:number, y:number)
.decl out(y:number)
.output out
.decl sup_q2_bf_r0_0(c0:number)
.decl sup_q2_bf_r0_1(c0:number, c1:number)
.decl q2_bf(c0:number, c1:number)
.decl sup_q2_bf_r1_0(c0:number)
.decl sup_q2_bf_r1_1(c0:number, c1:number)
.decl sup_q2_bf_r1_2(c0:number, c1:number)
.decl sup_q2_bf_r1_3(c0:number, c1:number)
.decl magic_q2_bf(c0:number)
.decl magic_s_b(c0:number)
.decl magic_p_bf(c0:number)
.decl sup_s_b_r0_0(c0:number)
.decl sup_s_b_r0_1(c0:number, c1:number)
.decl sup_s_b_r0_2(c0:number)
.decl s_b(c0:number)
.decl sup_p_bf_r0_0(c0:number)
.decl sup_p_bf_r0_1(c0:number, c1:number)
.decl p_bf(c0:number, c1:number)
.decl sup_p_bf_r1_0(c0:number)
.decl sup_p_bf_r1_1(c0:number, c1:number)
.decl sup_p_bf_r1_2(c0:number, c1:number)
sup_q2_bf_r0_0(x) :- magic_q2_bf(x).
sup_q2_bf_r0_1(x, y) :- sup_q2_bf_r0_0(x), base(x, y).
q2_bf(x, y) :- sup_q2_bf_r0_1(x, y).
sup_q2_bf_r1_0(x) :- magic_q2_bf(x).
sup_q2_bf_r1_1(x, z) :- sup_q2_bf_r1_0(x), q2_bf(x, z).
sup_q2_bf_r1_2(x, z) :- sup_q2_bf_r1_1(x, z), !s_b(z).
sup_q2_bf_r1_3(x, y) :- sup_q2_bf_r1_2(x, z), p_bf(z, y).
magic_q2_bf(x) :- sup_q2_bf_r1_0(x).
magic_s_b(z) :- sup_q2_bf_r1_1(x, z).
magic_p_bf(z) :- sup_q2_bf_r1_2(x, z).
q2_bf(x, y) :- sup_q2_bf_r1_3(x, y).
sup_s_b_r0_0(x) :- magic_s_b(x).
sup_s_b_r0_1(x, y) :- sup_s_b_r0_0(x), p_bf(x, y).
sup_s_b_r0_2(x) :- sup_s_b_r0_1(x, y), blocked(y).
magic_p_bf(x) :- sup_s_b_r0_0(x).
s_b(x) :- sup_s_b_r0_2(x).
sup_p_bf_r0_0(x) :- magic_p_bf(x).
sup_p_bf_r0_1(x, y) :- sup_p_bf_r0_0(x), e(x, y).
p_bf(x, y) :- sup_p_bf_r0_1(x, y).
sup_p_bf_r1_0(x) :- magic_p_bf(x).
sup_p_bf_r1_1(x, z) :- sup_p_bf_r1_0(x), p_bf(x, z).
sup_p_bf_r1_2(x, y) :- sup_p_bf_r1_1(x, z), base(z, y).
magic_p_bf(x) :- sup_p_bf_r1_0(x).
p_bf(x, y) :- sup_p_bf_r1_2(x, y).
magic_q2_bf(1).
out(y) :- q2_bf(1, y).
