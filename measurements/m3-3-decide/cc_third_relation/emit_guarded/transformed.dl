.decl base(x:number, y:number)
.input base
.decl e(x:number, y:number)
.input e
.decl blocked(x:number)
.input blocked
.decl p(x:number, y:number)
.decl s(x:number)
.decl q2(x:number, y:number)
.decl out(y:number)
.output out
p(x, y) :- e(x, y).
p(x, y) :- p(x, z), base(z, y).
q2(x, y) :- base(x, y).
q2(x, y) :- q2(x, z), !s(z), p(z, y).
s(x) :- p(x, y), blocked(y).
out(y) :- q2(1, y).
