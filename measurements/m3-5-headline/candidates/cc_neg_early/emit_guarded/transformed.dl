.decl base(x:number, y:number)
.input base
.decl link(x:number, y:number)
.input link
.decl blocked(x:number)
.input blocked
.decl q(x:number, y:number)
.decl s(x:number)
.decl p(x:number, y:number)
.decl out(y:number)
.output out
p(x, y) :- link(x, y).
p(x, y) :- link(x, z), !s(z), q(z, y).
q(x, y) :- base(x, y).
q(x, y) :- q(x, z), base(z, y).
s(x) :- q(x, y), blocked(y).
out(y) :- p(1, y).
