// CULPRIT_CANDIDATES: cc_arity3_twobound
//
// NIGHT-BATCH-03 T4 variant: arity 3 throughout (an edge label column),
// and the query binds TWO of p's three arguments (x=1, label=1; y free)
// rather than culprit_cycle.dl's single bound argument. Structurally
// matching: target_r=q is self-recursive (positive, per-label), s
// depends on q, !s(z,l) precedes q(z,y,l) in p's recursive rule.
//
// Fixture: harness/fixtures_lib.py's gen_culprit_cycle_facts_labeled
// (new -- see that function's docstring), num_labels=3, query fixed at
// label 1 (guaranteed connected by construction).

.decl base(x:number, y:number, l:number)     .input base
.decl e(x:number, y:number, l:number)        .input e
.decl blocked(x:number, l:number)            .input blocked

.decl q(x:number, y:number, l:number)
q(x,y,l) :- base(x,y,l).
q(x,y,l) :- q(x,z,l), base(z,y,l).

.decl s(x:number, l:number)
s(x,l) :- q(x,y,l), blocked(x,l).

.decl p(x:number, y:number, l:number)
p(x,y,l) :- e(x,y,l).
p(x,y,l) :- p(x,z,l), !s(z,l), q(z,y,l).

.decl out(y:number)   .output out
out(y) :- p(1,y,1).
