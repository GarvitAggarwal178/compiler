// CULPRIT_CANDIDATES: cc_neg_early
//
// NIGHT-BATCH-03 T4 variant: varies the POSITION of the negated literal
// relative to the target atom. In culprit_cycle.dl, !s(z) follows p's own
// positive self-reference (p(x,z), !s(z), q(z,y)). Here p is not
// self-recursive at all -- !s(z) is the second body literal overall,
// immediately preceded only by an EDB atom, with the positive target
// atom q(z,y) coming right after it. Still structurally matching:
// target_r=q is self-recursive (positive cycle), s depends on q, and
// q(z,y) is a positive atom following !s(z) in the same rule body.
//
// Fixture: harness/fixtures_lib.py's gen_culprit_cycle_facts (unmodified,
// "link" reuses the same edge-generator output as "e").

.decl base(x:number, y:number)     .input base
.decl link(x:number, y:number)     .input link
.decl blocked(x:number)            .input blocked

.decl q(x:number, y:number)
q(x,y) :- base(x,y).
q(x,y) :- q(x,z), base(z,y).

.decl s(x:number)
s(x) :- q(x,y), blocked(y).

.decl p(x:number, y:number)
p(x,y) :- link(x,y).
p(x,y) :- link(x,z), !s(z), q(z,y).

.decl out(y:number)   .output out
out(y) :- p(1,y).
