// CULPRIT_CANDIDATES: cc_query_bothbound
//
// NIGHT-BATCH-03 T4 variant: arity 2, but the query is fully ground on
// BOTH of p's arguments (out() :- p(1,5).) rather than culprit_cycle.dl's
// one-argument binding (out(y):-p(1,y)) -- adornment for p is `bb`, not
// `bf`. Zero-arity `out` uses M1-BUILD.md's authorized grammar amendment
// (term list in an atom is optional). Otherwise structurally identical
// to culprit_cycle.dl.
//
// Fixture: harness/fixtures_lib.py's gen_culprit_cycle_facts (unmodified).

.decl base(x:number, y:number)     .input base
.decl e(x:number, y:number)        .input e
.decl blocked(x:number)            .input blocked

.decl q(x:number, y:number)
q(x,y) :- base(x,y).
q(x,y) :- q(x,z), base(z,y).

.decl s(x:number)
s(x) :- q(x,y), blocked(y).

.decl p(x:number, y:number)
p(x,y) :- e(x,y).
p(x,y) :- p(x,z), !s(z), q(z,y).

.decl out()   .output out
out() :- p(1,5).
