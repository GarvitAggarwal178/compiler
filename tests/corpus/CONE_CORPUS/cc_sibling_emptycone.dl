// NIGHT-BATCH-04 B, construction 2: a sibling relation, cone stays
// empty.
//
// CONSTRUCTED for this task, per the 2026-08-22 ruling section 3.1
// disclosure rule. `p`/`q`/`s` are IDENTICAL to
// tests/corpus/BENCHMARK_FAMILY/culprit_cycle.dl (P5) -- `blocked`
// stays EDB, so ConeClosure({p,q,s}) still finds nothing (same as
// every CULPRIT_CANDIDATES program). Added: `tc`, a second, independent
// recursive relation and its own `.output` branch, reading a plain
// edge relation (`sibling_edge`) that shares no name and no dependency
// edge with the culprit core. `tc`/`out2` is a SIBLING relation
// (M2-M3-BUILD.md §7 / NIGHT-BATCH-04 B's own definition): not below
// the declined SCC in the dependency graph, so it stays TRANSFORMED
// while `p`/`q`/`s` fall back.

.decl base(x:number, y:number)          .input base
.decl e(x:number, y:number)             .input e
.decl blocked(x:number)                 .input blocked
.decl sibling_edge(x:number, y:number)  .input sibling_edge

.decl q(x:number, y:number)
q(x,y) :- base(x,y).
q(x,y) :- q(x,z), base(z,y).

.decl s(x:number)
s(x) :- q(x,y), blocked(y).

.decl p(x:number, y:number)
p(x,y) :- e(x,y).
p(x,y) :- p(x,z), !s(z), q(z,y).

.decl out(y:number)   .output out
out(y) :- p(1,y).

.decl tc(x:number, y:number)
tc(x,y) :- sibling_edge(x,y).
tc(x,y) :- tc(x,z), sibling_edge(z,y).

.decl out2(y:number)  .output out2
out2(y) :- tc(1,y).
