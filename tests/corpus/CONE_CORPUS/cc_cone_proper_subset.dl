// NIGHT-BATCH-04 B, construction 4: cone is a proper subset of the
// non-declined relations.
//
// CONSTRUCTED for this task, per the 2026-08-22 ruling section 3.1
// disclosure rule. `p`'s non-recursive base-case rule now reads
// `gate1`, which itself depends on `gate1b` (both IDB, `gate1b`
// recursive) -- a TWO-HOP cone, exercising `ConeClosure`'s BFS beyond
// one hop (constructions 1 and 3 only ever need a single hop). Both are
// read from `p`'s base case, not from `s` or `q` or `p`'s recursive
// rule -- see `cc_cone_only.dl`'s header comment for why that placement
// is required for a genuine cone rather than an enlarged culprit set.
// Independently, TWO sibling branches (`tc`, a recursive transitive
// closure, and `direct`, a non-recursive pass-through) read their own
// EDB relations and are not below the declined SCC at all. Non-culprit
// IDB relations total 4 (`gate1`,`gate1b`,`tc`,`direct`); the cone is
// exactly 2 of them (`gate1`,`gate1b`) -- a proper subset with a
// non-trivial (size-2) complement, not merely "the one thing outside
// cone."

.decl base(x:number, y:number)           .input base
.decl e(x:number, y:number)              .input e
.decl blocked(x:number)                  .input blocked
.decl chain_seed(x:number)               .input chain_seed
.decl chain_edge(x:number, y:number)     .input chain_edge
.decl sibling_edge(x:number, y:number)   .input sibling_edge
.decl sibling2_edge(x:number, y:number)  .input sibling2_edge

.decl q(x:number, y:number)
q(x,y) :- base(x,y).
q(x,y) :- q(x,z), base(z,y).

.decl gate1b(x:number)
gate1b(x) :- chain_seed(x).
gate1b(x) :- gate1b(y), chain_edge(y,x).

.decl gate1(x:number)
gate1(x) :- gate1b(x).

.decl s(x:number)
s(x) :- q(x,y), blocked(y).

.decl p(x:number, y:number)
p(x,y) :- e(x,y), gate1(x).
p(x,y) :- p(x,z), !s(z), q(z,y).

.decl out(y:number)   .output out
out(y) :- p(1,y).

.decl tc(x:number, y:number)
tc(x,y) :- sibling_edge(x,y).
tc(x,y) :- tc(x,z), sibling_edge(z,y).

.decl out2(y:number)  .output out2
out2(y) :- tc(1,y).

.decl direct(x:number, y:number)
direct(x,y) :- sibling2_edge(x,y).

.decl out3(y:number)  .output out3
out3(y) :- direct(1,y).
