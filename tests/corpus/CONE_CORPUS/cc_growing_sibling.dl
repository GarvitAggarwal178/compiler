// PUNCH-LIST-2 item 2: the deliberate opposite of `cc_sibling_emptycone.dl`.
//
// CONSTRUCTED for this task, per the 2026-08-22 ruling section 3.1
// disclosure rule. Structurally IDENTICAL to `cc_sibling_emptycone.dl`
// (same `p`/`q`/`s` culprit core reading `base`/`e`/`blocked`, same
// `tc`/`out2` sibling reading `sibling_edge`) -- the only difference is
// the FIXTURE: `harness/fixtures_lib.py`'s `gen_growing_sibling_facts`
// pins the culprit core at a FIXED size at every scale point and lets
// the sibling's own reachable-from-1 set grow LINEARLY with `n` (via
// `gen_core_rest_graph`, `core_size=n`) -- the deliberate opposite of
// `gen_cone_corpus_facts`'s fixed-edge-count sibling, which
// PUNCH-LIST-2 item 1 found actually shrinks as `n` grows. Pre-
// registered prediction: `docs/OPEN_QUESTIONS.md` Q13, committed before
// this program was measured.

.decl base(x:number, y:number)          .input base
.decl e(x:number, y:number)             .input e
.decl blocked(x:number)                 .input blocked
.decl sibling_edge(x:number, y:number)  .input sibling_edge

.decl q(x:number, y:number)
q(x,y) :- base(x,y).
q(x,y) :- q(x,z), base(z,y).

.decl s(x:number)
s(x) :- q(x,y), blocked(y).

.decl p(x:number, y:number)
p(x,y) :- e(x,y).
p(x,y) :- p(x,z), !s(z), q(z,y).

.decl out(y:number)   .output out
out(y) :- p(1,y).

.decl tc(x:number, y:number)
tc(x,y) :- sibling_edge(x,y).
tc(x,y) :- tc(x,z), sibling_edge(z,y).

.decl out2(y:number)  .output out2
out2(y) :- tc(1,y).
