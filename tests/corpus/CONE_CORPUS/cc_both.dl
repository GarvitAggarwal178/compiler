// NIGHT-BATCH-04 B, construction 3: nonempty cone AND a sibling, in the
// same program.
//
// CONSTRUCTED for this task, per the 2026-08-22 ruling section 3.1
// disclosure rule. Combines construction 1's `gate` (an IDB relation
// below the declined {p,q,s} SCC, feeding a nonempty cone) with
// construction 2's `tc`/`out2` (a sibling branch that stays
// transformed). Exercises all three regions NIGHT-BATCH-04 B asks for
// in a single program: the declined SCC ({p,q,s}), cone relations
// strictly below it (`gate`), and a sibling not below it (`tc`). `gate`
// is read from `p`'s non-recursive base-case rule, not `s`'s -- see
// `cc_cone_only.dl`'s header comment for why that placement is required
// for a genuine cone rather than an enlarged culprit set.

.decl base(x:number, y:number)          .input base
.decl e(x:number, y:number)             .input e
.decl blocked(x:number)                 .input blocked
.decl gate_seed(x:number)               .input gate_seed
.decl gate_edge(x:number, y:number)     .input gate_edge
.decl sibling_edge(x:number, y:number)  .input sibling_edge

.decl q(x:number, y:number)
q(x,y) :- base(x,y).
q(x,y) :- q(x,z), base(z,y).

.decl gate(x:number)
gate(x) :- gate_seed(x).
gate(x) :- gate(y), gate_edge(y,x).

.decl s(x:number)
s(x) :- q(x,y), blocked(y).

.decl p(x:number, y:number)
p(x,y) :- e(x,y), gate(x).
p(x,y) :- p(x,z), !s(z), q(z,y).

.decl out(y:number)   .output out
out(y) :- p(1,y).

.decl tc(x:number, y:number)
tc(x,y) :- sibling_edge(x,y).
tc(x,y) :- tc(x,z), sibling_edge(z,y).

.decl out2(y:number)  .output out2
out2(y) :- tc(1,y).
